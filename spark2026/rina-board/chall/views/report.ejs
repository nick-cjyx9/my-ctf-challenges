<!doctype html>
<html lang="zh-CN">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>邀请 A.L.A.N. 访问</title>
  <link rel="stylesheet" href="/app.css">
</head>

<body class="center-page">
  <main class="login-card">
    <h2>提交页面给管理员 A.L.A.N.</h2>
    <% if (message) { %>
      <p class="notice">
        <%= message %>
      </p>
      <% } %>
        <form method="post" class="stack" id="report-form">
          <input name="url" type="url" placeholder="https://example.com/" maxlength="2048" required>
          <input name="powId" type="hidden">
          <input name="nonce" type="hidden">
          <p id="pow-status" class="pow-status"></p>
          <button class="primary" type="submit">提交</button>
        </form>
        <script>
          window.POW = <%- JSON.stringify(pow) %>
        </script>
        <script src="/report.js"></script>
        <p class="queue-status" style="margin-top: 12px;">运行中的任务：<%= status.active %>/2，等待中：<%= status.queued %></p>
        <a class="back-link" href="/">返回首页</a>
  </main>
</body>

</html>
